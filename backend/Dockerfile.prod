# Use official Node.js 18 LTS image
FROM node:18-alpine

# Set working directory
WORKDIR /app

# Copy package.json and package-lock.json
COPY package*.json ./

# Install only production dependencies
RUN npm install --production

# Copy app source
COPY . .

# Expose port backend will run on
EXPOSE 5000

# Start the server
CMD ["node", "server.js"]
